@model IEnumerable<LigaPro.Models.Equipo>

@{
    ViewData["Title"] = "Equipos";
}

<h1>@ViewData["Title"]</h1>

<p>
    <a class="btn btn-primary" asp-action="Create">Crear Nuevo Equipo</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>    </th>
            <th>Nombre</th>
            <th>Partidos Jugados</th>
            <th>Partidos Ganados</th>
            <th>Partidos Empatados</th>
            <th>Partidos Perdidos</th>
            
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @if (!string.IsNullOrEmpty(item.LogoUrl))
                    {
                        <img src="@item.LogoUrl" alt="Logo de @item.Nombre" style="max-width: 50px; height: auto;" />
                    }
                </td>
                <td>
                    <a href="@Url.Action("Details", "Equipo", new { id = item.EquipoId })">
                        @item.Nombre
                    </a>
                </td>
                <td>@item.PartidosJugados</td>
                <td>@item.PartidosGanados</td>
                <td>@item.PartidosEmpatados</td>
                <td>@item.PartidosPerdidos</td>
                
                <td>
                    <a class="btn btn-warning" asp-action="Edit" asp-route-id="@item.EquipoId">Editar</a> |
                    <a class="btn btn-info" asp-action="Details" asp-route-id="@item.EquipoId">Información</a> |
                    <a class="btn btn-danger" asp-action="Delete" asp-route-id="@item.EquipoId">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>
